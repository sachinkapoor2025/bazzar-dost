# Copy to .env and replace every value. Never commit .env.

# PostgreSQL connection string for the managed database.
# Amplify SSR must be able to reach this host over TLS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bazaardost?sslmode=require"

# At least 32 random characters. Used to sign the login cookie.
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Public site URL used for canonical links, the sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Shown on the contact page when set. Leave blank if you have no public inbox yet.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Optional public profile links. Leave blank when a profile is not set up.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
# NEXT_PUBLIC_SOCIAL_FACEBOOK=""
# NEXT_PUBLIC_SOCIAL_YOUTUBE=""

# Optional. When both are set, `npm run db:setup` creates this admin if the email is new.
# Do not use these example values in production.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Image storage. Required in production. Leave unset during local development to keep files under public/.
# Credentials can be omitted when the Amplify compute role can write to the bucket.
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional. Public image origin when the bucket is served through CloudFront. No trailing slash.
# AWS_S3_PUBLIC_BASE_URL=""

# Optional outbound email. Password reset sends mail only when all three are set.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
