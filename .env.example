# Copy to .env and replace every value. Never commit .env.

DATABASE_URL="file:./dev.db"

# At least 32 random characters. Used to sign the login cookie.
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Public site URL used for canonical links, the sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Shown on the contact page when set. Leave blank if you have no public inbox yet.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Optional. When both are set, `npm run db:setup` creates this admin if the email is new.
# Do not use these example values in production.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional outbound email. Password reset sends mail only when all three are set.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
