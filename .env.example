# Copy to .env and replace every value. Never commit .env.

# Lambda API used by the Next.js server. Local default is the in-memory API.
API_URL="http://127.0.0.1:4000"

# At least 32 random characters. The storefront and the API must use the same value.
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Public site URL used for canonical links, the sitemap, password-reset emails, and Open Graph.
# Keep localhost for `npm run dev`. Production builds use https://bazaardost.com from .env.production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Shown on the contact page when set. Leave blank if you have no public inbox yet.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Optional public profile links. Leave blank when a profile is not set up.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
# NEXT_PUBLIC_SOCIAL_FACEBOOK=""
# NEXT_PUBLIC_SOCIAL_YOUTUBE=""

# Optional first admin. The API creates this account on startup when both are set and the email is new.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Filled from the BazaarDost CloudFormation outputs after the stack exists.
# Do not use table names, buckets, or user pools from another shop.
# NEXT_PUBLIC_CDN_URL=""
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=""
# NEXT_PUBLIC_COGNITO_CLIENT_ID=""
# NEXT_PUBLIC_COGNITO_REGION="us-east-1"

# Optional outbound email. Password reset sends mail only when all three are set.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
