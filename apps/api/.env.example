# Local API. Copy to apps/api/.env only if you want values different from the repo root .env.
USE_MEMORY_DB=true
ENVIRONMENT=local
PORT=4000
# Must match the storefront SESSION_SECRET.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Optional first admin, created on API startup when both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# DynamoDB Local, after docker compose up and npm run db:setup:
# USE_MEMORY_DB=false
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
