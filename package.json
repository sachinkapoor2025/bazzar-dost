{
  "name": "bazaardost",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm run dev -w @bazaardost/api",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/commerce.test.ts tests/site.test.ts apps/api/src/store.test.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "tsx apps/api/src/setup-local-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "bcryptjs": "^2.4.3",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "nodemailer": "^7.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
